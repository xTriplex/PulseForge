{
	"version": 5,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 24,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "windows-editor",
			"displayName": "Windows Editor",
			"generator": "Visual Studio 17 2022",
			"architecture": "x64",
			"binaryDir": "${sourceDir}/Build/CMakePresets/windows-editor",
			"vendor": {
				"microsoft.com/VisualStudioSettings/CMake/1.0": {
					"hostOS": [ "Windows" ]
				}
			}
		},
		{
			"name": "windows-core",
			"displayName": "Windows Core and CPU tests",
			"inherits": "windows-editor",
			"binaryDir": "${sourceDir}/Build/CMakePresets/windows-core",
			"cacheVariables": {
				"PULSEFORGE_BUILD_CORE_ONLY": "ON",
				"PULSEFORGE_BUILD_EDITOR": "OFF",
				"BUILD_TESTING": "ON"
			},
			"vendor": {
				"microsoft.com/VisualStudioSettings/CMake/1.0": {
					"hostOS": [ "Windows" ]
				}
			}
		},
		{
			"name": "linux-core",
			"displayName": "Linux Core and CPU tests",
			"generator": "Unix Makefiles",
			"binaryDir": "${sourceDir}/Build/CMakePresets/linux-core",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"PULSEFORGE_BUILD_CORE_ONLY": "ON",
				"PULSEFORGE_BUILD_EDITOR": "OFF",
				"BUILD_TESTING": "ON"
			},
			"vendor": {
				"microsoft.com/VisualStudioSettings/CMake/1.0": {
					"hostOS": [ "Linux" ]
				}
			}
		}
	],
	"buildPresets": [
		{
			"name": "windows-editor-debug",
			"configurePreset": "windows-editor",
			"configuration": "Debug"
		},
		{
			"name": "windows-editor-release",
			"configurePreset": "windows-editor",
			"configuration": "Release"
		},
		{
			"name": "windows-editor-dist",
			"configurePreset": "windows-editor",
			"configuration": "Dist"
		},
		{
			"name": "windows-core-debug",
			"configurePreset": "windows-core",
			"configuration": "Debug"
		},
		{
			"name": "linux-core-debug",
			"configurePreset": "linux-core"
		}
	],
	"testPresets": [
		{
			"name": "windows-editor-debug",
			"configurePreset": "windows-editor",
			"configuration": "Debug",
			"output": { "outputOnFailure": true }
		},
		{
			"name": "windows-editor-release",
			"configurePreset": "windows-editor",
			"configuration": "Release",
			"output": { "outputOnFailure": true }
		},
		{
			"name": "windows-editor-dist",
			"configurePreset": "windows-editor",
			"configuration": "Dist",
			"output": { "outputOnFailure": true }
		},
		{
			"name": "windows-core-debug",
			"configurePreset": "windows-core",
			"configuration": "Debug",
			"output": { "outputOnFailure": true }
		},
		{
			"name": "linux-core-debug",
			"configurePreset": "linux-core",
			"output": { "outputOnFailure": true }
		}
	]
}
