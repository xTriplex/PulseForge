{
	"version": 5,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 24,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "Windows-Editor",
			"displayName": "Windows Editor",
			"generator": "Visual Studio 17 2022",
			"architecture": "x64",
			"binaryDir": "${sourceDir}/Build/CMakePresets/WindowsEditor",
			"vendor": {
				"microsoft.com/VisualStudioSettings/CMake/1.0": {
					"hostOS": [ "Windows" ]
				}
			}
		},
		{
			"name": "Windows-Core",
			"displayName": "Windows Core and CPU Tests",
			"inherits": "Windows-Editor",
			"binaryDir": "${sourceDir}/Build/CMakePresets/WindowsCore",
			"cacheVariables": {
				"PULSEFORGE_BUILD_CORE_ONLY": "ON",
				"PULSEFORGE_BUILD_EDITOR": "OFF",
				"BUILD_TESTING": "ON"
			},
			"vendor": {
				"microsoft.com/VisualStudioSettings/CMake/1.0": {
					"hostOS": [ "Windows" ]
				}
			}
		},
		{
			"name": "Linux-Core",
			"displayName": "Linux Core and CPU Tests",
			"generator": "Unix Makefiles",
			"binaryDir": "${sourceDir}/Build/CMakePresets/LinuxCore",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"PULSEFORGE_BUILD_CORE_ONLY": "ON",
				"PULSEFORGE_BUILD_EDITOR": "OFF",
				"BUILD_TESTING": "ON"
			},
			"vendor": {
				"microsoft.com/VisualStudioSettings/CMake/1.0": {
					"hostOS": [ "Linux" ]
				}
			}
		}
	],
	"buildPresets": [
		{
			"name": "Windows-Editor-Debug",
			"displayName": "Windows Editor Debug",
			"configurePreset": "Windows-Editor",
			"configuration": "Debug"
		},
		{
			"name": "Windows-Editor-Release",
			"displayName": "Windows Editor Release",
			"configurePreset": "Windows-Editor",
			"configuration": "Release"
		},
		{
			"name": "Windows-Editor-Dist",
			"displayName": "Windows Editor Dist",
			"configurePreset": "Windows-Editor",
			"configuration": "Dist"
		},
		{
			"name": "Windows-Core-Debug",
			"displayName": "Windows Core Debug",
			"configurePreset": "Windows-Core",
			"configuration": "Debug"
		},
		{
			"name": "Linux-Core-Debug",
			"displayName": "Linux Core Debug",
			"configurePreset": "Linux-Core"
		}
	],
	"testPresets": [
		{
			"name": "Windows-Editor-Debug",
			"displayName": "Windows Editor Debug",
			"configurePreset": "Windows-Editor",
			"configuration": "Debug",
			"output": { "outputOnFailure": true }
		},
		{
			"name": "Windows-Editor-Release",
			"displayName": "Windows Editor Release",
			"configurePreset": "Windows-Editor",
			"configuration": "Release",
			"output": { "outputOnFailure": true }
		},
		{
			"name": "Windows-Editor-Dist",
			"displayName": "Windows Editor Dist",
			"configurePreset": "Windows-Editor",
			"configuration": "Dist",
			"output": { "outputOnFailure": true }
		},
		{
			"name": "Windows-Core-Debug",
			"displayName": "Windows Core Debug",
			"configurePreset": "Windows-Core",
			"configuration": "Debug",
			"output": { "outputOnFailure": true }
		},
		{
			"name": "Linux-Core-Debug",
			"displayName": "Linux Core Debug",
			"configurePreset": "Linux-Core",
			"output": { "outputOnFailure": true }
		}
	]
}
