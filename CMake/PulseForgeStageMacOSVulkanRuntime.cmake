if(NOT DEFINED PF_APP_BUNDLE OR NOT DEFINED PF_EXECUTABLE OR NOT DEFINED PF_RESOURCE_DIR)
	message(FATAL_ERROR "macOS Vulkan bundle staging arguments are incomplete")
endif()
if(NOT DEFINED ENV{VULKAN_SDK} OR "$ENV{VULKAN_SDK}" STREQUAL "")
	message(FATAL_ERROR "macOS Vulkan application bundles require the configured Vulkan SDK at build time")
endif()

set(SDK_ROOT "$ENV{VULKAN_SDK}")
set(LOADER_SOURCE "${SDK_ROOT}/lib/libvulkan.1.dylib")
set(MOLTENVK_SOURCE "${SDK_ROOT}/lib/libMoltenVK.dylib")
file(GLOB ICD_CANDIDATES LIST_DIRECTORIES FALSE "${SDK_ROOT}/share/vulkan/icd.d/*MoltenVK*.json")
if(NOT EXISTS "${LOADER_SOURCE}" OR NOT EXISTS "${MOLTENVK_SOURCE}" OR NOT ICD_CANDIDATES)
	message(FATAL_ERROR "The configured Vulkan SDK is missing its loader, MoltenVK runtime, or ICD manifest")
endif()

file(MAKE_DIRECTORY "${PF_APP_BUNDLE}/Contents/Frameworks" "${PF_RESOURCE_DIR}/vulkan/icd.d")
file(COPY_FILE "${LOADER_SOURCE}" "${PF_APP_BUNDLE}/Contents/Frameworks/libvulkan.1.dylib" ONLY_IF_DIFFERENT)
file(COPY_FILE "${MOLTENVK_SOURCE}" "${PF_APP_BUNDLE}/Contents/Frameworks/libMoltenVK.dylib" ONLY_IF_DIFFERENT)
list(GET ICD_CANDIDATES 0 ICD_SOURCE)
file(READ "${ICD_SOURCE}" ICD_DOCUMENT)
string(JSON ICD_DOCUMENT SET "${ICD_DOCUMENT}" ICD library_path "\"../../../Frameworks/libMoltenVK.dylib\"")
file(WRITE "${PF_RESOURCE_DIR}/vulkan/icd.d/MoltenVK_icd.json" "${ICD_DOCUMENT}\n")

find_program(INSTALL_NAME_TOOL install_name_tool REQUIRED)
find_program(OTOOL_EXECUTABLE otool REQUIRED)
execute_process(COMMAND "${INSTALL_NAME_TOOL}" -id "@rpath/libvulkan.1.dylib"
	"${PF_APP_BUNDLE}/Contents/Frameworks/libvulkan.1.dylib" RESULT_VARIABLE PATCH_LOADER_RESULT)
if(NOT PATCH_LOADER_RESULT EQUAL 0)
	message(FATAL_ERROR "Could not set the bundled Vulkan loader install name")
endif()
execute_process(COMMAND "${INSTALL_NAME_TOOL}" -id "@rpath/libMoltenVK.dylib"
	"${PF_APP_BUNDLE}/Contents/Frameworks/libMoltenVK.dylib" RESULT_VARIABLE PATCH_MOLTENVK_RESULT)
if(NOT PATCH_MOLTENVK_RESULT EQUAL 0)
	message(FATAL_ERROR "Could not set the bundled MoltenVK install name")
endif()

foreach(BUNDLE_BINARY IN ITEMS "${PF_EXECUTABLE}" "${PF_APP_BUNDLE}/Contents/Frameworks/libvulkan.1.dylib"
		"${PF_APP_BUNDLE}/Contents/Frameworks/libMoltenVK.dylib")
	execute_process(COMMAND "${OTOOL_EXECUTABLE}" -l "${BUNDLE_BINARY}"
		RESULT_VARIABLE INSPECTION_RESULT OUTPUT_VARIABLE LOAD_COMMANDS ERROR_VARIABLE INSPECTION_ERROR)
	if(NOT INSPECTION_RESULT EQUAL 0)
		message(FATAL_ERROR "Could not inspect runtime paths for ${BUNDLE_BINARY}: ${INSPECTION_ERROR}")
	endif()
	if("${BUNDLE_BINARY}" STREQUAL "${PF_EXECUTABLE}")
		set(REQUIRED_RPATH "@executable_path/../Frameworks")
	else()
		set(REQUIRED_RPATH "@loader_path")
	endif()
	string(FIND "${LOAD_COMMANDS}" "${REQUIRED_RPATH}" RPATH_POSITION)
	if(RPATH_POSITION EQUAL -1)
		execute_process(COMMAND "${INSTALL_NAME_TOOL}" -add_rpath "${REQUIRED_RPATH}" "${BUNDLE_BINARY}"
			RESULT_VARIABLE ADD_RPATH_RESULT ERROR_VARIABLE ADD_RPATH_ERROR)
		if(NOT ADD_RPATH_RESULT EQUAL 0)
			message(FATAL_ERROR "Could not add ${REQUIRED_RPATH} to ${BUNDLE_BINARY}: ${ADD_RPATH_ERROR}")
		endif()
	endif()
endforeach()
