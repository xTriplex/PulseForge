function(pulseforge_attach_asset_deployment Target OutputDirectory)
	cmake_parse_arguments(PARSE_ARGV 2 Deployment "" "" "DIRECTORIES;FILES")
	if(NOT TARGET "${Target}")
		message(FATAL_ERROR "Cannot attach runtime-asset deployment to missing target '${Target}'")
	endif()
	if(Deployment_UNPARSED_ARGUMENTS)
		message(FATAL_ERROR "Unexpected runtime-asset deployment arguments: ${Deployment_UNPARSED_ARGUMENTS}")
	endif()
	list(LENGTH Deployment_DIRECTORIES DirectoryArgumentCount)
	list(LENGTH Deployment_FILES FileArgumentCount)
	math(EXPR DirectoryArgumentRemainder "${DirectoryArgumentCount} % 2")
	math(EXPR FileArgumentRemainder "${FileArgumentCount} % 2")
	if(DirectoryArgumentCount EQUAL 0 AND FileArgumentCount EQUAL 0)
		message(FATAL_ERROR "Runtime-asset deployment for '${Target}' requires DIRECTORIES or FILES")
	endif()
	if(NOT DirectoryArgumentRemainder EQUAL 0 OR NOT FileArgumentRemainder EQUAL 0)
		message(FATAL_ERROR "Runtime-asset deployment for '${Target}' requires source/destination pairs")
	endif()

	string(MAKE_C_IDENTIFIER "${Target}_RuntimeAssetDeployment" DeploymentTarget)
	if(TARGET "${DeploymentTarget}")
		message(FATAL_ERROR "Runtime-asset deployment target '${DeploymentTarget}' already exists")
	endif()
	set(DeploymentCommands COMMAND "${CMAKE_COMMAND}" -E make_directory "${OutputDirectory}")

	set(DirectoryIndex 0)
	while(DirectoryIndex LESS DirectoryArgumentCount)
		list(GET Deployment_DIRECTORIES ${DirectoryIndex} SourceDirectory)
		math(EXPR DestinationIndex "${DirectoryIndex} + 1")
		list(GET Deployment_DIRECTORIES ${DestinationIndex} DestinationRelativeDirectory)
		if(NOT IS_DIRECTORY "${SourceDirectory}")
			message(FATAL_ERROR "Runtime-asset source directory does not exist: '${SourceDirectory}'")
		endif()
		pulseforge_validate_asset_deployment_destination("${Target}" "${DestinationRelativeDirectory}")
		list(APPEND DeploymentCommands
			COMMAND "${CMAKE_COMMAND}" -E make_directory "${OutputDirectory}/${DestinationRelativeDirectory}"
			COMMAND "${CMAKE_COMMAND}" -E copy_directory "${SourceDirectory}"
				"${OutputDirectory}/${DestinationRelativeDirectory}")
		math(EXPR DirectoryIndex "${DirectoryIndex} + 2")
	endwhile()

	set(FileIndex 0)
	while(FileIndex LESS FileArgumentCount)
		list(GET Deployment_FILES ${FileIndex} SourceFile)
		math(EXPR DestinationIndex "${FileIndex} + 1")
		list(GET Deployment_FILES ${DestinationIndex} DestinationRelativeFile)
		if(NOT EXISTS "${SourceFile}" OR IS_DIRECTORY "${SourceFile}")
			message(FATAL_ERROR "Runtime-asset source file does not exist: '${SourceFile}'")
		endif()
		pulseforge_validate_asset_deployment_destination("${Target}" "${DestinationRelativeFile}")
		get_filename_component(DestinationRelativeDirectory "${DestinationRelativeFile}" DIRECTORY)
		if(NOT DestinationRelativeDirectory STREQUAL "")
			list(APPEND DeploymentCommands COMMAND "${CMAKE_COMMAND}" -E make_directory
				"${OutputDirectory}/${DestinationRelativeDirectory}")
		endif()
		list(APPEND DeploymentCommands COMMAND "${CMAKE_COMMAND}" -E copy_if_different
			"${SourceFile}" "${OutputDirectory}/${DestinationRelativeFile}")
		math(EXPR FileIndex "${FileIndex} + 2")
	endwhile()

	# This target intentionally runs on every build. It repairs missing output and copies source-only changes
	# without forcing the executable to relink. Files that no longer have a source are left untouched.
	add_custom_target("${DeploymentTarget}" ${DeploymentCommands} VERBATIM
		COMMENT "Deploying runtime assets for ${Target}")
	add_dependencies("${Target}" "${DeploymentTarget}")
endfunction()

function(pulseforge_validate_asset_deployment_destination Target Destination)
	if(Destination STREQUAL "" OR IS_ABSOLUTE "${Destination}")
		message(FATAL_ERROR "Runtime-asset deployment for '${Target}' requires a non-empty relative destination")
	endif()
	string(REPLACE "\\" "/" DestinationWithForwardSlashes "${Destination}")
	if(DestinationWithForwardSlashes MATCHES "(^|/)[.][.](/|$)")
		message(FATAL_ERROR "Runtime-asset destination escapes the output root for '${Target}': '${Destination}'")
	endif()
endfunction()
