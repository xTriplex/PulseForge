function(pulseforge_assert_no_runtime_target_dependency RootTarget ForbiddenTarget)
	if(NOT TARGET "${RootTarget}" OR NOT TARGET "${ForbiddenTarget}")
		message(FATAL_ERROR "Runtime target closure check requires both '${RootTarget}' and '${ForbiddenTarget}' targets")
	endif()

	get_target_property(ResolvedForbidden "${ForbiddenTarget}" ALIASED_TARGET)
	if(NOT ResolvedForbidden)
		set(ResolvedForbidden "${ForbiddenTarget}")
	endif()
	get_target_property(ResolvedRoot "${RootTarget}" ALIASED_TARGET)
	if(NOT ResolvedRoot)
		set(ResolvedRoot "${RootTarget}")
	endif()

	set(PendingTargets "${ResolvedRoot}")
	set(VisitedTargets)
	while(PendingTargets)
		list(POP_FRONT PendingTargets CurrentTarget)
		if(CurrentTarget IN_LIST VisitedTargets)
			continue()
		endif()
		list(APPEND VisitedTargets "${CurrentTarget}")
		set(LinkProperties LINK_LIBRARIES INTERFACE_LINK_LIBRARIES INTERFACE_LINK_LIBRARIES_DIRECT)
		get_target_property(IsImported "${CurrentTarget}" IMPORTED)
		if(IsImported)
			list(APPEND LinkProperties IMPORTED_LINK_DEPENDENT_LIBRARIES)
			get_target_property(ModernInterface "${CurrentTarget}" INTERFACE_LINK_LIBRARIES)
			if(NOT ModernInterface)
				list(APPEND LinkProperties IMPORTED_LINK_INTERFACE_LIBRARIES)
			endif()
		endif()
		get_target_property(ImportedConfigurations "${CurrentTarget}" IMPORTED_CONFIGURATIONS)
		set(ImportedConfigurations ${ImportedConfigurations} NOCONFIG DEBUG RELEASE RELWITHDEBINFO MINSIZEREL)
		list(REMOVE_DUPLICATES ImportedConfigurations)
		foreach(Configuration IN LISTS ImportedConfigurations)
			string(TOUPPER "${Configuration}" ConfigurationUpper)
			list(APPEND LinkProperties "IMPORTED_LINK_DEPENDENT_LIBRARIES_${ConfigurationUpper}")
			if(IsImported AND NOT ModernInterface)
				list(APPEND LinkProperties "IMPORTED_LINK_INTERFACE_LIBRARIES_${ConfigurationUpper}")
			endif()
		endforeach()
		foreach(LinkProperty IN LISTS LinkProperties)
			get_target_property(LinkItems "${CurrentTarget}" "${LinkProperty}")
			if(NOT LinkItems OR LinkItems MATCHES "-NOTFOUND$")
				continue()
			endif()

			# Inspect every target-shaped token, including both branches of conditional/link generator expressions.
			# This is intentionally conservative: a forbidden target in any configuration is rejected.
			foreach(LinkItem IN LISTS LinkItems)
				string(REGEX MATCHALL "[A-Za-z0-9_][A-Za-z0-9_.:+-]*" CandidateNames "${LinkItem}")
				foreach(Candidate IN LISTS CandidateNames)
					if(NOT TARGET "${Candidate}")
						continue()
					endif()
					get_target_property(ResolvedCandidate "${Candidate}" ALIASED_TARGET)
					if(NOT ResolvedCandidate)
						set(ResolvedCandidate "${Candidate}")
					endif()
					if(ResolvedCandidate STREQUAL ResolvedForbidden)
						message(FATAL_ERROR
							"${RootTarget} cooked runtime closure must not link ${ForbiddenTarget} (reached through ${CurrentTarget})")
					endif()
					list(APPEND PendingTargets "${ResolvedCandidate}")
				endforeach()
			endforeach()
		endforeach()
	endwhile()
endfunction()
