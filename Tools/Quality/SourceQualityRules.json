{
  "source_roots": [
    "PulseForge/Source",
    "PulseForgeEditor/Source",
    "PulseForgeGame/Source",
    "Tests"
  ],
  "default_cpp_line_limit": 1700,
  "default_header_line_limit": 800,
  "source_target_ownership": {
    "PulseForge/Source/Private/Assets/AudioAssetCache.cpp": "PulseForgeAudioAssets",
    "PulseForgeEditor/Source/Private/EditorAssetDestinationDialog.cpp": "PulseForgeEditorUI",
    "PulseForgeEditor/Source/Private/EditorConsolePanel.cpp": "PulseForgeEditorUI",
    "PulseForgeEditor/Source/Private/EditorAssetSelector.cpp": "PulseForgeEditorUI",
    "PulseForgeEditor/Source/Private/EditorContentBrowserAssetView.cpp": "PulseForgeEditorUI",
    "PulseForgeEditor/Source/Private/EditorContentBrowserPanel.cpp": "PulseForgeEditorUI",
    "PulseForgeEditor/Source/Private/EditorHierarchyPanel.cpp": "PulseForgeEditorUI",
    "PulseForgeEditor/Source/Private/EditorMaterialDetailsPanel.cpp": "PulseForgeEditorUI",
    "PulseForgeEditor/Source/Private/EditorContentBrowserNavigation.cpp": "PulseForgeEditorUI",
    "PulseForgeEditor/Source/Private/EditorViewportToolbar.cpp": "PulseForgeEditorUI",
    "PulseForgeEditor/Source/Private/EditorViewportToolState.cpp": "PulseForgeEditorCore",
    "PulseForgeEditor/Source/Private/EditorViewportSceneRenderView.cpp": "PulseForgeEditor"
  },
  "size_exceptions": {
    "PulseForgeEditor/Source/Private/EditorApplication.cpp": {
      "max_lines": 9200,
      "reason": "Editor lifecycle coordination remains, while viewport, panel, workflow and state owners are extracted."
    },
    "PulseForge/Source/Private/Renderer/Vulkan/VulkanRenderer.cpp": {
      "max_lines": 3813,
      "reason": "Legacy backend implementation with presentation ownership still being decomposed."
    },
    "Tests/GpuRendererValidation.cpp": {
      "max_lines": 3707,
      "reason": "Legacy GPU validation executable pending suite decomposition."
    },
    "PulseForge/Source/Private/Renderer/SceneRenderer.cpp": {
      "max_lines": 2684,
      "reason": "Legacy scene rendering implementation pending responsibility extraction."
    }
  },
  "editor_core_target": "PulseForgeEditorCore",
  "editor_core_allowed_dependencies": [
    "PulseForgeAssetImporters",
    "PulseForgeAssetServices",
    "PulseForgeScene",
    "PulseForgeSceneSerialization"
  ],
  "editor_ui_target": "PulseForgeEditorUI",
  "editor_ui_allowed_dependencies": [
    "PulseForgeRenderer",
    "PulseForgeApplication",
    "PulseForgeAssetImporters",
    "PulseForgeAssetServices",
    "PulseForgeEditorCore",
    "PulseForgeImGui",
    "freetype",
    "spdlog::spdlog",
    "shell32",
    "ole32"
  ],
  "aggregate_engine_target": "PulseForge",
  "owner_scoped_test_targets": [
    "PulseForgeTests",
    "PulseForgeEditorTests",
    "PulseForgeBufferUpdateTests",
    "PulseForgeAssetImportTests",
    "PulseForgeAudioRuntimeTests"
  ],
  "editor_core_forbidden_includes": [
    "Core/PulseForgePCH.h",
    "Core/Application.h",
    "Renderer/Vulkan/",
    "imgui.h",
    "backends/",
    "nvrhi/",
    "vulkan/",
    "GLFW/",
    "glad/"
  ],
  "public_header_roots": {
    "PulseForge/Source/Public": [
      "PulseForge/Source/Private/",
      "PulseForgeEditor/Source/",
      "PulseForgeGame/Source/Private/",
      "Core/PulseForgePCH.h"
    ],
    "PulseForgeEditor/Source/Public": [
      "PulseForgeEditor/Source/Private/",
      "PulseForge/Source/Private/",
      "Core/PulseForgePCH.h"
    ],
    "PulseForgeGame/Source/Public": [
      "PulseForgeGame/Source/Private/",
      "PulseForge/Source/Private/",
      "Core/PulseForgePCH.h"
    ]
  }
}
