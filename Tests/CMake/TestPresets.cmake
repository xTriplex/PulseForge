set(PULSEFORGE_PRESETS_FILE "${PULSEFORGE_SOURCE_ROOT}/CMakePresets.json")
file(READ "${PULSEFORGE_PRESETS_FILE}" PULSEFORGE_PRESETS_JSON)
string(JSON PULSEFORGE_PRESETS_VERSION GET "${PULSEFORGE_PRESETS_JSON}" version)
if(NOT PULSEFORGE_PRESETS_VERSION EQUAL 5)
	message(FATAL_ERROR "PulseForge presets must retain schema version 5.")
endif()

string(JSON PULSEFORGE_WINDOWS_EDITOR_GENERATOR GET "${PULSEFORGE_PRESETS_JSON}" configurePresets 0 generator)
string(JSON PULSEFORGE_WINDOWS_EDITOR_BINARY_DIR GET "${PULSEFORGE_PRESETS_JSON}" configurePresets 0 binaryDir)
string(JSON PULSEFORGE_WINDOWS_EDITOR_HOST_OS GET "${PULSEFORGE_PRESETS_JSON}" configurePresets 0 vendor
	"microsoft.com/VisualStudioSettings/CMake/1.0" hostOS 0)
if(NOT PULSEFORGE_WINDOWS_EDITOR_GENERATOR STREQUAL "Visual Studio 17 2022")
	message(FATAL_ERROR "The Windows editor preset must use the existing Visual Studio multi-config generator.")
endif()
if(NOT PULSEFORGE_WINDOWS_EDITOR_HOST_OS STREQUAL "Windows")
	message(FATAL_ERROR "The Windows editor preset must be limited to Windows Visual Studio target systems.")
endif()
string(JSON PULSEFORGE_WINDOWS_EDITOR_BUILD_TYPE ERROR_VARIABLE PULSEFORGE_WINDOWS_EDITOR_BUILD_TYPE_ERROR
	GET "${PULSEFORGE_PRESETS_JSON}" configurePresets 0 cacheVariables CMAKE_BUILD_TYPE)
if(PULSEFORGE_WINDOWS_EDITOR_BUILD_TYPE_ERROR STREQUAL "NOTFOUND")
	message(FATAL_ERROR "The multi-configuration Windows editor preset must not set CMAKE_BUILD_TYPE.")
endif()
string(JSON PULSEFORGE_LINUX_CORE_HOST_OS GET "${PULSEFORGE_PRESETS_JSON}" configurePresets 2 vendor
	"microsoft.com/VisualStudioSettings/CMake/1.0" hostOS 0)
if(NOT PULSEFORGE_LINUX_CORE_HOST_OS STREQUAL "Linux")
	message(FATAL_ERROR "The Linux Core preset must remain available for Linux and WSL target systems.")
endif()

set(PULSEFORGE_EXPECTED_EDITOR_CONFIGURATIONS Debug Release Dist)
foreach(PULSEFORGE_CONFIGURATION IN LISTS PULSEFORGE_EXPECTED_EDITOR_CONFIGURATIONS)
	string(TOLOWER "${PULSEFORGE_CONFIGURATION}" PULSEFORGE_CONFIGURATION_LOWER)
	set(PULSEFORGE_PRESET_NAME "windows-editor-${PULSEFORGE_CONFIGURATION_LOWER}")
	set(PULSEFORGE_FOUND_BUILD_PRESET FALSE)
	string(JSON PULSEFORGE_BUILD_PRESET_COUNT LENGTH "${PULSEFORGE_PRESETS_JSON}" buildPresets)
	math(EXPR PULSEFORGE_BUILD_PRESET_LAST_INDEX "${PULSEFORGE_BUILD_PRESET_COUNT} - 1")
	foreach(PULSEFORGE_INDEX RANGE 0 ${PULSEFORGE_BUILD_PRESET_LAST_INDEX})
		string(JSON PULSEFORGE_BUILD_PRESET_NAME GET "${PULSEFORGE_PRESETS_JSON}" buildPresets ${PULSEFORGE_INDEX} name)
		if(PULSEFORGE_BUILD_PRESET_NAME STREQUAL PULSEFORGE_PRESET_NAME)
			string(JSON PULSEFORGE_BUILD_PRESET_CONFIGURE GET "${PULSEFORGE_PRESETS_JSON}" buildPresets ${PULSEFORGE_INDEX} configurePreset)
			string(JSON PULSEFORGE_BUILD_PRESET_CONFIGURATION GET "${PULSEFORGE_PRESETS_JSON}" buildPresets ${PULSEFORGE_INDEX} configuration)
			if(NOT PULSEFORGE_BUILD_PRESET_CONFIGURE STREQUAL "windows-editor")
				message(FATAL_ERROR "${PULSEFORGE_PRESET_NAME} must reuse the windows-editor configure preset.")
			endif()
			if(NOT PULSEFORGE_BUILD_PRESET_CONFIGURATION STREQUAL PULSEFORGE_CONFIGURATION)
				message(FATAL_ERROR "${PULSEFORGE_PRESET_NAME} must select ${PULSEFORGE_CONFIGURATION}.")
			endif()
			string(JSON PULSEFORGE_BUILD_PRESET_HAS_TARGETS ERROR_VARIABLE PULSEFORGE_TARGETS_ERROR
				GET "${PULSEFORGE_PRESETS_JSON}" buildPresets ${PULSEFORGE_INDEX} targets)
			if(PULSEFORGE_TARGETS_ERROR STREQUAL "NOTFOUND")
				message(FATAL_ERROR "${PULSEFORGE_PRESET_NAME} must build the normal target set.")
			endif()
			set(PULSEFORGE_FOUND_BUILD_PRESET TRUE)
		endif()
	endforeach()
	if(NOT PULSEFORGE_FOUND_BUILD_PRESET)
		message(FATAL_ERROR "Missing ${PULSEFORGE_PRESET_NAME} build preset.")
	endif()

	set(PULSEFORGE_FOUND_TEST_PRESET FALSE)
	string(JSON PULSEFORGE_TEST_PRESET_COUNT LENGTH "${PULSEFORGE_PRESETS_JSON}" testPresets)
	math(EXPR PULSEFORGE_TEST_PRESET_LAST_INDEX "${PULSEFORGE_TEST_PRESET_COUNT} - 1")
	foreach(PULSEFORGE_INDEX RANGE 0 ${PULSEFORGE_TEST_PRESET_LAST_INDEX})
		string(JSON PULSEFORGE_TEST_PRESET_NAME GET "${PULSEFORGE_PRESETS_JSON}" testPresets ${PULSEFORGE_INDEX} name)
		if(PULSEFORGE_TEST_PRESET_NAME STREQUAL PULSEFORGE_PRESET_NAME)
			string(JSON PULSEFORGE_TEST_PRESET_CONFIGURE GET "${PULSEFORGE_PRESETS_JSON}" testPresets ${PULSEFORGE_INDEX} configurePreset)
			string(JSON PULSEFORGE_TEST_PRESET_CONFIGURATION GET "${PULSEFORGE_PRESETS_JSON}" testPresets ${PULSEFORGE_INDEX} configuration)
			if(NOT PULSEFORGE_TEST_PRESET_CONFIGURE STREQUAL "windows-editor" OR
				NOT PULSEFORGE_TEST_PRESET_CONFIGURATION STREQUAL PULSEFORGE_CONFIGURATION)
				message(FATAL_ERROR "${PULSEFORGE_PRESET_NAME} test preset does not match its build configuration.")
			endif()
			set(PULSEFORGE_FOUND_TEST_PRESET TRUE)
		endif()
	endforeach()
	if(NOT PULSEFORGE_FOUND_TEST_PRESET)
		message(FATAL_ERROR "Missing ${PULSEFORGE_PRESET_NAME} test preset.")
	endif()
endforeach()

execute_process(
	COMMAND "${PULSEFORGE_CMAKE_COMMAND}" --list-presets=all
	WORKING_DIRECTORY "${PULSEFORGE_SOURCE_ROOT}"
	RESULT_VARIABLE PULSEFORGE_LIST_PRESETS_RESULT
	OUTPUT_VARIABLE PULSEFORGE_LIST_PRESETS_OUTPUT
	ERROR_VARIABLE PULSEFORGE_LIST_PRESETS_ERROR)
if(NOT PULSEFORGE_LIST_PRESETS_RESULT EQUAL 0)
	message(FATAL_ERROR "cmake --list-presets=all failed: ${PULSEFORGE_LIST_PRESETS_ERROR}")
endif()
foreach(PULSEFORGE_REQUIRED_PRESET IN ITEMS
	windows-core-debug linux-core-debug windows-editor-debug windows-editor-release windows-editor-dist)
	if(NOT PULSEFORGE_LIST_PRESETS_OUTPUT MATCHES "${PULSEFORGE_REQUIRED_PRESET}")
		message(FATAL_ERROR "cmake --list-presets=all omitted ${PULSEFORGE_REQUIRED_PRESET}.")
	endif()
endforeach()

message(STATUS "Windows editor Debug, Release and Dist presets share ${PULSEFORGE_WINDOWS_EDITOR_BINARY_DIR}.")
