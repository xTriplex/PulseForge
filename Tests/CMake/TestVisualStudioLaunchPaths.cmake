foreach(PULSEFORGE_TARGET IN ITEMS PulseForgeEditor PulseForgeGame)
	set(PULSEFORGE_PROJECT "${PULSEFORGE_BINARY_DIR}/${PULSEFORGE_TARGET}.vcxproj")
	if(NOT EXISTS "${PULSEFORGE_PROJECT}")
		message(FATAL_ERROR "Generated Visual Studio project is missing: ${PULSEFORGE_PROJECT}")
	endif()

	foreach(PULSEFORGE_CONFIGURATION IN ITEMS Debug Release Dist)
		execute_process(
			COMMAND "${PULSEFORGE_MSBUILD_EXECUTABLE}" "${PULSEFORGE_PROJECT}"
				-nologo
				"-property:Configuration=${PULSEFORGE_CONFIGURATION}"
				"-property:Platform=${PULSEFORGE_PLATFORM}"
				-getProperty:LocalDebuggerWorkingDirectory,OutDir,TargetPath
			RESULT_VARIABLE PULSEFORGE_MSBUILD_RESULT
			OUTPUT_VARIABLE PULSEFORGE_MSBUILD_OUTPUT
			ERROR_VARIABLE PULSEFORGE_MSBUILD_ERROR)
		if(NOT PULSEFORGE_MSBUILD_RESULT EQUAL 0)
			message(FATAL_ERROR
				"MSBuild could not evaluate ${PULSEFORGE_TARGET} ${PULSEFORGE_CONFIGURATION}: "
				"${PULSEFORGE_MSBUILD_ERROR}${PULSEFORGE_MSBUILD_OUTPUT}")
		endif()

		string(JSON PULSEFORGE_WORKING_DIRECTORY GET "${PULSEFORGE_MSBUILD_OUTPUT}"
			Properties LocalDebuggerWorkingDirectory)
		string(JSON PULSEFORGE_OUTPUT_DIRECTORY GET "${PULSEFORGE_MSBUILD_OUTPUT}" Properties OutDir)
		string(JSON PULSEFORGE_TARGET_PATH GET "${PULSEFORGE_MSBUILD_OUTPUT}" Properties TargetPath)
		get_filename_component(PULSEFORGE_TARGET_DIRECTORY "${PULSEFORGE_TARGET_PATH}" DIRECTORY)

		file(TO_CMAKE_PATH "${PULSEFORGE_WORKING_DIRECTORY}" PULSEFORGE_WORKING_DIRECTORY)
		file(TO_CMAKE_PATH "${PULSEFORGE_OUTPUT_DIRECTORY}" PULSEFORGE_OUTPUT_DIRECTORY)
		file(TO_CMAKE_PATH "${PULSEFORGE_TARGET_DIRECTORY}" PULSEFORGE_TARGET_DIRECTORY)
		cmake_path(NORMAL_PATH PULSEFORGE_WORKING_DIRECTORY)
		cmake_path(NORMAL_PATH PULSEFORGE_OUTPUT_DIRECTORY)
		cmake_path(NORMAL_PATH PULSEFORGE_TARGET_DIRECTORY)
		if(NOT PULSEFORGE_WORKING_DIRECTORY STREQUAL PULSEFORGE_OUTPUT_DIRECTORY)
			message(FATAL_ERROR
				"${PULSEFORGE_TARGET} ${PULSEFORGE_CONFIGURATION} debugger working directory "
				"does not resolve to its configured output directory.")
		endif()
		if(NOT PULSEFORGE_TARGET_DIRECTORY STREQUAL PULSEFORGE_OUTPUT_DIRECTORY)
			message(FATAL_ERROR
				"${PULSEFORGE_TARGET} ${PULSEFORGE_CONFIGURATION} executable is outside its configured output directory.")
		endif()
	endforeach()
endforeach()

message(STATUS "Generated Visual Studio Editor and Game launch paths match Debug, Release and Dist output directories.")
