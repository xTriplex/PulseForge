foreach(RequiredVariable IN ITEMS PULSEFORGE_FIXTURE_SOURCE_DIR PULSEFORGE_TEST_BINARY_DIR PULSEFORGE_TEST_GENERATOR
		PULSEFORGE_DEPLOYMENT_MODULE)
	if(NOT DEFINED ${RequiredVariable} OR "${${RequiredVariable}}" STREQUAL "")
		message(FATAL_ERROR "${RequiredVariable} is required for runtime-asset deployment validation")
	endif()
endforeach()

set(GeneratorArguments -G "${PULSEFORGE_TEST_GENERATOR}")
foreach(GeneratorProperty IN ITEMS PLATFORM TOOLSET)
	set(GeneratorValue "${PULSEFORGE_TEST_GENERATOR_${GeneratorProperty}}")
	if(NOT GeneratorValue STREQUAL "")
		if(GeneratorProperty STREQUAL "PLATFORM")
			list(APPEND GeneratorArguments -A "${GeneratorValue}")
		else()
			list(APPEND GeneratorArguments -T "${GeneratorValue}")
		endif()
	endif()
endforeach()
if(PULSEFORGE_TEST_CONFIGURATION AND NOT PULSEFORGE_TEST_GENERATOR MATCHES "Visual Studio|Xcode|Multi-Config")
	list(APPEND GeneratorArguments "-DCMAKE_BUILD_TYPE=${PULSEFORGE_TEST_CONFIGURATION}")
endif()

file(REMOVE_RECURSE "${PULSEFORGE_TEST_BINARY_DIR}")
execute_process(
	COMMAND "${CMAKE_COMMAND}" -S "${PULSEFORGE_FIXTURE_SOURCE_DIR}" -B "${PULSEFORGE_TEST_BINARY_DIR}"
		${GeneratorArguments} "-DPULSEFORGE_DEPLOYMENT_MODULE=${PULSEFORGE_DEPLOYMENT_MODULE}"
	RESULT_VARIABLE ConfigureResult OUTPUT_VARIABLE ConfigureOutput ERROR_VARIABLE ConfigureError
)
if(NOT ConfigureResult EQUAL 0)
	message(FATAL_ERROR "Could not configure runtime-asset deployment fixture:\n${ConfigureOutput}\n${ConfigureError}")
endif()

function(build_runtime_asset_fixture)
	set(BuildArguments --build "${PULSEFORGE_TEST_BINARY_DIR}" --parallel 2 --verbose)
	if(PULSEFORGE_TEST_CONFIGURATION)
		list(APPEND BuildArguments --config "${PULSEFORGE_TEST_CONFIGURATION}")
	endif()
	execute_process(
		COMMAND "${CMAKE_COMMAND}" ${BuildArguments}
		RESULT_VARIABLE BuildResult OUTPUT_VARIABLE BuildOutput ERROR_VARIABLE BuildError
	)
	if(NOT BuildResult EQUAL 0)
		message(FATAL_ERROR "Runtime-asset deployment fixture build failed:\n${BuildOutput}\n${BuildError}")
	endif()
endfunction()

set(RuntimeRoot "${PULSEFORGE_TEST_BINARY_DIR}/runtime")
set(TextureAsset "${RuntimeRoot}/Assets/Textures/fixture.texture")
set(MaterialAsset "${RuntimeRoot}/Assets/Materials/fixture.material")
set(ProjectFile "${RuntimeRoot}/FixtureRuntime.pfproj")
set(StaleDestinationFile "${RuntimeRoot}/Assets/Materials/unowned.user-file")
set(TargetPathFile "${PULSEFORGE_TEST_BINARY_DIR}/fixture-target-${PULSEFORGE_TEST_CONFIGURATION}.txt")
if(NOT EXISTS "${TargetPathFile}")
	message(FATAL_ERROR "The fixture did not generate its runtime target path: '${TargetPathFile}'")
endif()
file(READ "${TargetPathFile}" RuntimeExecutable)
build_runtime_asset_fixture()
if(NOT EXISTS "${RuntimeExecutable}")
	message(FATAL_ERROR "The runtime fixture executable was not built: '${RuntimeExecutable}'")
endif()
foreach(DeployedFile IN ITEMS "${TextureAsset}" "${MaterialAsset}" "${ProjectFile}")
	if(NOT EXISTS "${DeployedFile}")
		message(FATAL_ERROR "Initial build did not deploy '${DeployedFile}'")
	endif()
endforeach()
file(READ "${TextureAsset}" TextureContents)
file(READ "${MaterialAsset}" MaterialContents)
file(READ "${ProjectFile}" ProjectContents)
if(NOT TextureContents STREQUAL "texture source version one" OR
	NOT MaterialContents STREQUAL "material source version one" OR
	NOT ProjectContents STREQUAL "project source version one")
	message(FATAL_ERROR "Initial runtime assets were deployed with unexpected contents")
endif()

file(WRITE "${StaleDestinationFile}" "retain unowned destination data")
file(TIMESTAMP "${RuntimeExecutable}" InitialExecutableTime "%Y-%m-%d %H:%M:%S" UTC)
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 2)
file(WRITE "${PULSEFORGE_TEST_BINARY_DIR}/source/Assets/Textures/fixture.texture" "texture source version two")
build_runtime_asset_fixture()
file(READ "${TextureAsset}" UpdatedTextureContents)
if(NOT UpdatedTextureContents STREQUAL "texture source version two")
	message(FATAL_ERROR "A source-only runtime asset change was not deployed")
endif()
file(TIMESTAMP "${RuntimeExecutable}" UpdatedExecutableTime "%Y-%m-%d %H:%M:%S" UTC)
if(NOT UpdatedExecutableTime STREQUAL InitialExecutableTime)
	message(FATAL_ERROR "Deploying a source-only asset change relinked the executable")
endif()

file(REMOVE "${TextureAsset}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 2)
build_runtime_asset_fixture()
if(NOT EXISTS "${TextureAsset}")
	message(FATAL_ERROR "An incremental build did not restore a missing deployed asset")
endif()
file(READ "${TextureAsset}" RestoredTextureContents)
if(NOT RestoredTextureContents STREQUAL "texture source version two")
	message(FATAL_ERROR "Restored runtime asset differs from its source")
endif()
file(TIMESTAMP "${RuntimeExecutable}" RestoredExecutableTime "%Y-%m-%d %H:%M:%S" UTC)
if(NOT RestoredExecutableTime STREQUAL InitialExecutableTime)
	message(FATAL_ERROR "Repairing a missing deployed asset relinked the executable")
endif()
if(NOT EXISTS "${StaleDestinationFile}")
	message(FATAL_ERROR "Runtime deployment removed an unowned destination file")
endif()
